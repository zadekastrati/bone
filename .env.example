APP_NAME="boné"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Production: set APP_URL=https://your-domain.tld, APP_DEBUG=false, APP_FORCE_HTTPS=true
APP_FORCE_HTTPS=false

# Local dev uses Laravel Sail (compose.yaml). Production: use your host’s DB/Mail settings.

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=bone_app
DB_USERNAME=sail
DB_PASSWORD=password
# Host port published to your machine. If 3306 is already taken (local MySQL), use e.g. 3307.
FORWARD_DB_PORT=3307

# Railway: add the MySQL plugin and link it to this service. Laravel also reads MYSQLHOST, MYSQLPORT,
# MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD, MYSQL_URL if DB_* are unset (see config/database.php).
# Or set DATABASE_URL / MYSQL_URL to the connection string from the database service.

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# "local" stores uploads on disk. Set to "s3" to serve the "public" disk from Cloudflare R2 instead
# (see the AWS_* block below) — everything in the app already reads/writes via Storage::disk('public').
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# Production: use database or redis + php artisan queue:work (order emails are queued when not sync)
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Production (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

# Behind nginx / Cloudflare / load balancer: TRUSTED_PROXIES=* (or comma-separated proxy IPs)
TRUSTED_PROXIES=

# Storefront (shipping rates are fixed per country in config/store.php: XK, AL, MK only)
STORE_CURRENCY=EUR
STORE_CURRENCY_SYMBOL=€
STORE_DEFAULT_COUNTRY=XK
STORE_BANK_ACCOUNT_NAME=
STORE_BANK_IBAN=
STORE_BANK_BIC=
STORE_BANK_REFERENCE_PREFIX=BONE
STORE_BANK_INSTRUCTIONS="Use your order number as the payment reference. Transfer may take 1–2 business days."

# Quipu/ProCredit "3DSS2" card payment gateway. Auth is mutual TLS — cert_path/key_path/ca_path
# point at PEM files that are NEVER committed (storage/app/quipu/ is gitignored). The cert's Common
# Name must equal QUIPU_MERCHANT_ID. Test and production use completely separate values — never mix.
QUIPU_MERCHANT_ID=
QUIPU_ORDER_ENDPOINT=
QUIPU_CERT_PATH=
QUIPU_KEY_PATH=
QUIPU_CA_PATH=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — use smtp in production with your provider (Mailtrap, SendGrid, SES, etc.).
# Local dev: Mailpit (docker compose) on 127.0.0.1:1025, UI http://localhost:8025 — set MAIL_ENCRYPTION=null
# Production example (TLS): MAIL_PORT=587 MAIL_ENCRYPTION=tls
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Verify SMTP end-to-end: php artisan mail:test your@email.com
# Optional: php artisan mail:test your@email.com --order=1 (use a real order ID for the second email)

# Cloudflare R2 credentials — only needed when FILESYSTEM_DISK=s3. Get these from an R2 API token
# scoped to a single bucket (Object Read & Write). Never commit real values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has no real regions; Cloudflare's documented SDK value is "auto".
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com — from the R2 bucket's "S3 API" settings.
AWS_ENDPOINT=
# Cloudflare's documented example config for the S3-compatible endpoint.
AWS_USE_PATH_STYLE_ENDPOINT=true
# Public base URL for serving files — the bucket's public access URL (r2.dev) or connected custom
# domain. Separate from AWS_ENDPOINT, which is only for authenticated API calls (upload/delete).
AWS_URL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sail (optional — Linux file permissions inside the container)
# WWWGROUP=1000
# WWWUSER=1000
